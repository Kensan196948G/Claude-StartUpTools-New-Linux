{
  "_comment": "AgentTeams managed-agents 設定テンプレート（ClaudeOS v11 実行設定契約）。コピーして config/managed-agents.json に保存し、各 ID を埋めて使う。API キーは必ず環境変数 ANTHROPIC_API_KEY 経由とし、このファイルには絶対に書かない。",
  "_security": "config/managed-agents.json は .gitignore で除外済み。万一コミットしないこと。",
  "_contract": {
    "_comment": "読み手: lib/managed-agents.sh + scripts/tools/managed-session-payload.js + scripts/tools/managed-permission-policy.js。schema 不成立時は Goal Router が execution_plane=local へフォールバックする。",
    "enabled": "bool — Managed 実行 Plane の有効化スイッチ。false は常に local。",
    "mode": "disabled|dry-run|live — live は課金承認(人間決裁)済みのときのみ設定する。dry-run は payload を生成・記録するが API 呼び出ししない。",
    "apiBaseUrl": "Managed Agents API ベース URL (既定 https://api.anthropic.com)",
    "betaHeader": "anthropic-beta ヘッダ値 (既定 managed-agents-2026-04-01)",
    "environmentId": "env_... 必須 (dry-run を含め payload 生成に必要)",
    "orchestratorId": "agent_... 必須 (Managed Orchestrator)",
    "vaultIds": ["vlt_..."],
    "budget": "既定 budget {amountCents(セント整数文字列), currency:'USD'}。Session 作成時 budget は必須(後付け不可)。budget 無し Session の Managed 自律実行は禁止。",
    "github": "workspace: Repository Resource (主系・ファイル操作)。mcp: PR/Issue 操作のみ (toolset 限定)。MCP によるファイル系操作は禁止 (2026-06 crash 教訓: docs/claude/07 §6-3)。",
    "permissionPolicy": "scripts/tools/managed-permission-policy.js の分類をオーバーライドする追加リスト(任意)。allow|conditional|human_gate。",
    "inferenceGeo": "推論実行場所 (global 推奨)。未指定は workspace default_inference_geo。",
    "advisorModel": "アドバイザーモデル (任意, null 可)。"
  },
  "enabled": false,
  "mode": "disabled",
  "apiBaseUrl": "https://api.anthropic.com",
  "betaHeader": "managed-agents-2026-04-01",
  "memoryStoreId": "memstore_xxxxxxxxxxxxxxxxxxxxxxxx",
  "environmentId": "env_xxxxxxxxxxxxxxxxxxxxxxxx",
  "environment": {
    "_comment": "Environment Manager 設定。networking は unrestricted 依存を減らすため limited + allowlist を既定とする (P2 で本格移行)。",
    "networking": "limited",
    "allowedDomains": ["api.githubcopilot.com", "api.github.com"],
    "selfHosted": false
  },
  "github": {
    "workspace": {
      "type": "repository_resource",
      "_comment": "主系: GitHub Repository Resource を workspace mount し、ファイル操作は mount 内の git で行う。",
      "resource": "repo:ORG/REPO",
      "mountPath": "/workspace/repo"
    },
    "mcp": {
      "type": "url",
      "_comment": "GitHub リモート MCP は PR/Issue 操作専用。ファイル系ツールは blockedTools で禁止。",
      "url": "https://api.githubcopilot.com/mcp",
      "allowedTools": ["create_pull_request", "add_issue_comment", "create_branch", "list_commits"],
      "blockedTools": ["get_file_contents", "create_or_update_file", "push_files", "push_files_to_branch", "delete_file", "delete_branch"]
    }
  },
