{
  "_comment": "Claude Code スタートアップツール設定テンプレート v4.0.0-linux - コピーしてconfig.jsonとして使用",
  "version": "4.0.0-linux",
  "projects": "/home/kensan/Projects",
  "projectsDir": "/home/kensan/Projects",
  "_localExcludes_comment": "config_project_list の除外正本 (L1メニュー/cron/autonomy/docker 全4経路に効く)。製品でないツール repo・バックアップ・アーカイブ・純インフラ等の git フォルダをここへ列挙して自動開発対象から外す。worktree (.git がファイル) と本ツール repo 自身 (CCSU_ROOT) は config-loader が自動除外するため記載不要。新規プロジェクトの cron 登録手順は docs/claude/11_新規プロジェクトのcron登録とオンボーディング.md を参照。",
  "localExcludes": [],
  "tools": {
    "defaultTool": "claude",
    "claude": {
      "enabled": true,
      "displayName": "Claude Code (Anthropic)",
      "command": "claude",
      "_args_comment": "PR-G で --dangerously-skip-permissions を撤去。権限は settings/auto-mode と headless の --permission-mode dontAsk へ委譲し、起動引数に権限ロジックを持ち込まない (多経路化回避)。",
      "args": [],
      "headless": {
        "_comment": "PR-G 新設。claude -p ヘッドレス既定運用の正本設定。cron.headlessDefault=true と整合。enabled=false で従来 TUI へ戻す (CLAUDEOS_HEADLESS=0 相当)。",
        "enabled": true,
        "outputFormat": "stream-json",
        "permissionMode": "dontAsk",
        "appendSystemPromptFile": "",
        "resume": true
      },
      "installCommand": "npm install -g @anthropic-ai/claude-code",
      "checkCommand": "claude --version",
      "env": {
        "ENABLE_TOOL_SEARCH": "true",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
        "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true"
      },
      "settings": {
        "language": "日本語",
        "outputStyle": "Explanatory",
        "alwaysThinkingEnabled": true,
        "spinnerTipsEnabled": true,
        "prefersReducedMotion": false,
        "promptSuggestionEnabled": true,
        "respectGitignore": true,
        "autoUpdatesChannel": "latest",
        "includeCoAuthoredBy": true,
        "teammateMode": "auto"
      },
      "apiKeyEnvVar": "ANTHROPIC_API_KEY"
    },
    "codex": {
      "enabled": false,
      "_disabled_reason": "Claude Code 専用のため無効化。将来復活の保険としてフィールドは保持。",
      "displayName": "Codex CLI (OpenAI)",
      "command": "codex",
      "args": [
        "--full-auto"
      ],
      "installCommand": "npm install -g @openai/codex",
      "checkCommand": "codex --version",
      "env": {
        "OPENAI_API_KEY": ""
      },
      "apiKeyEnvVar": "OPENAI_API_KEY"
    },
    "copilot": {
      "enabled": false,
      "_disabled_reason": "Claude Code 専用のため無効化。将来復活の保険としてフィールドは保持。",
      "displayName": "GitHub Copilot CLI",
      "command": "copilot",
      "args": [
        "--yolo"
      ],
      "installCommand": "npm install -g @github/copilot",
      "checkCommand": "copilot --version",
      "env": {},
      "apiKeyEnvVar": ""
    }
  },
  "logging": {
    "enabled": true,
    "logDir": "logs",
    "logPrefix": "ai-startup",
    "successKeepDays": 30,
    "failureKeepDays": 90
  },
  "backupConfig": {
    "enabled": true,
    "backupDir": "config/backups",
    "maxBackups": 10,
    "maskSensitive": true,
    "sensitiveKeys": [
      "tools.claude.env.ANTHROPIC_API_KEY",
      "tools.codex.env.OPENAI_API_KEY"
    ]
  },
  "recentProjects": {
    "enabled": true,
    "maxHistory": 10,
    "historyFile": "~/.ai-startup/recent-projects.json"
  },
  "notifications": {
    "_comment": "Linux 通知音設定。soundEnabled:false で無効化できます。",
    "soundEnabled": false,
    "playOnStart": true,
    "playOnExit": true,
    "sounds": {
      "claude":  "",
      "codex":   "",
      "copilot": ""
    }
  },
  "cron": {
    "_comment": "v3.1.0 新設。Linux 側 crontab で ClaudeCode を週次自動起動する機能の設定。",
    "enabled": true,
    "defaultDurationMinutes": 300,
    "launcherPath": "/home/kensan/.claudeos/cron-launcher.sh",
    "sessionsDir": "/home/kensan/.claudeos/sessions",
    "logsDir": "/home/kensan/.claudeos/logs",
    "entryPrefix": "CLAUDEOS",
    "_headlessDefault_comment": "PR-G で既定反転。true = cron 起動は claude -p ヘッドレス既定 (CLAUDEOS_HEADLESS 未設定=1 と整合)。false で従来 tmux TUI 既定へ戻す (CLAUDEOS_HEADLESS=0 相当の退避経路)。",
    "headlessDefault": true
  },
  "agentSdk": {
    "_comment": "PR-E 新設。claude -p / Agent SDK headless の月次クレジット可視化・上限ガード設定 (2026-06-15 課金変更対応)。monthlyBudgetUsd=0 は無制限 (ガード無効)。warn/verifyOnly/stop は消費率(%)の段階閾値で CLAUDE.md §9 と同型。ledgerPath は credits__record の追記先 (~ 展開は credits.sh が CCSU_HOME 基準で解決)。",
    "monthlyBudgetUsd": 0,
    "warnPct": 70,
    "verifyOnlyPct": 85,
    "stopPct": 95,
    "ledgerPath": "/home/kensan/.claudeos/credits/ledger.jsonl"
  },
  "email": {
    "_comment": "v3.2.0 新設。Cron セッション終了時に HTML レポートメールを送信。SMTP 認証情報は Linux 環境変数で管理 (CLAUDEOS_SMTP_USER / CLAUDEOS_SMTP_PASS) — config.json には書かない。送信トリガーは Linux 側 CLAUDEOS_EMAIL_ENABLED=1 で明示的に有効化。詳細は docs/common/16_HTMLメールレポート設定.md を参照。",
    "enabled": false,
    "smtp": {
      "host": "smtp.gmail.com",
      "port": 587,
      "useStartTls": true,
      "userEnvVar": "CLAUDEOS_SMTP_USER",
      "passEnvVar": "CLAUDEOS_SMTP_PASS"
    },
    "from": "<your-email>",
    "to": "<your-email>",
    "subjectPrefix": "[ClaudeOS]",
    "scriptPath": "/home/kensan/.claudeos/report-and-mail.py",
    "enableEnvVar": "CLAUDEOS_EMAIL_ENABLED"
  },
  "sessionTabs": {
    "_comment": "tmux/libexec/watch-session.sh によるセッション情報表示。",
    "enabled": true,
    "title": "Claude Session Info",
    "pollIntervalSeconds": 1,
    "autoCloseAfterExitSeconds": 10,
    "localSessionsDir": "~/.claudeos/sessions"
  },
  "statusline": {
    "_comment": "v3.1.0 新設。メニュー 13 で実行される、グローバル statusLine 設定を Linux 側に一括同期する設定。",
    "enabled": true,
    "sourceSettingsPath": "~/.claude/settings.json",
    "targetSettingsPath": "~/.claude/settings.json",
    "backupBeforeApply": true
  }
}
