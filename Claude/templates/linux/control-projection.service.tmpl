# claudeos-@PROJECT@-control-projection.service — Control Plane 射影ワーカー (ClaudeOS v11)
# Generated by bin/control-db.sh units @PROJECT@ @DB@ . Secrets are never embedded here.
[Unit]
Description=ClaudeOS @PROJECT@ Control Plane projection worker (@DB@)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@CCSU_ROOT@
Environment=PG_BIN=@PG_BIN@
Environment=PGHOST=/var/run/postgresql
Environment=CTL_DB=@DB@
Environment=CLAUDEOS_CONTROL_MODE=dual-write
Environment=CCSU_CONTROL_STATE_DIR=@HOME@/.claudeos/control-plane
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node scripts/tools/control-projection.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.claudeos
UMask=0077

[Install]
WantedBy=multi-user.target
