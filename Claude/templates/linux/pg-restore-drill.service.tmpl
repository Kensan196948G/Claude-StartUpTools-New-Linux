# claudeos-@PROJECT@-pg-restore-drill.service — weekly restore drill into @DB@_recovery (ClaudeOS v10)
# "バックアップが存在する" だけでは成功にしない: 実際に restore し、テーブル数と行数を元 DB と照合する。
[Unit]
Description=ClaudeOS @PROJECT@ PostgreSQL restore drill (@DB@ -> @DB@_recovery)
After=postgresql.service claudeos-@PROJECT@-pg-backup.service
Requires=postgresql.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@CCSU_ROOT@
Environment=PG_BIN=@PG_BIN@
Environment=PGHOST=/var/run/postgresql
Environment=CCSU_PG_BACKUP_ROOT=/var/backups/claudeos
Environment=CLAUDEOS_PLAIN_OUTPUT=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash bin/pg-ops.sh restore-drill @DB@ @BACKUP_DIR@/latest.dump
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@BACKUP_DIR@
ReadWritePaths=@HOME@/.claudeos
UMask=0077

[Install]
WantedBy=multi-user.target
