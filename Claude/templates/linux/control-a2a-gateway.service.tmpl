# claudeos-@PROJECT@-control-a2a-gateway.service — Control Plane A2A Gateway (ClaudeOS v11)
# Generated by bin/control-db.sh units @PROJECT@ @DB@ . Secrets are never embedded here.
#
# localhost 限定の常駐 HTTP API (Codex / DeepSeek Harness からの Task Passport
# 受け渡し・run lifecycle 呼び出し用)。0.0.0.0 では listen しない。外部公開・
# DNS が必要になった場合は Approval PR で別途扱うこと (本 unit の対象外)。
[Unit]
Description=ClaudeOS @PROJECT@ Control Plane A2A Gateway (@DB@, 127.0.0.1 only)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@CCSU_ROOT@
Environment=PG_BIN=@PG_BIN@
Environment=PGHOST=/var/run/postgresql
Environment=CTL_DB=@DB@
Environment=CCSU_CONTROL_STATE_DIR=@HOME@/.claudeos/control-plane
Environment=CCSU_A2A_PORT=8730
Environment=CLAUDEOS_PLAIN_OUTPUT=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node scripts/tools/a2a-gateway.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.claudeos
UMask=0077
# IPAddressAllow は systemd 側の追加の防御層。ゲートウェイ自身も 127.0.0.1
# にのみ bind するため、これが外れても外部到達性は生まれない。
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
