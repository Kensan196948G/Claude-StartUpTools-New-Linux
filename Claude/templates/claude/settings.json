{
  "respectGitignore": true,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "includeCoAuthoredBy": true,
  "fallbackModel": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "requiredMinimumVersion": "2.1.224",
  "outputStyle": "Explanatory",
  "language": "日本語",
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": true,
  "autoUpdatesChannel": "latest",
  "prefersReducedMotion": false,
  "terminal": {
    "mode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/pre-commit-gate.js\"",
            "if": "Bash(git commit *)",
            "continueOnBlock": true,
            "timeout": 240,
            "statusMessage": "pre-commit gate: lint / test:quick"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/pre-compact.js\"",
            "timeout": 20,
            "statusMessage": "state.json を退避中"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/session-start.js\"",
            "timeout": 20,
            "statusMessage": "state.json から再開情報を読込中"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/post-compact-reinject.js\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/heartbeat-writer.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/notification-gate.js\"",
            "async": true
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/notification-gate.js\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/session-end.js\"",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/stop-failure-gate.js\"",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/usage-tracker.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Agent|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/agent-teams-tracker.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/audit-trail.js\"",
            "timeout": 10,
            "async": true,
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/audit-trail.js\"",
            "timeout": 10,
            "async": true,
            "if": "Bash(gh *)"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/claudeos/scripts/hooks/audit-trail.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git stash*)",
      "Bash(git worktree *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge --auto --squash *)",
      "Bash(gh run *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh api -X GET *)",
      "Bash(gh api repos/*)",
      "Bash(gh auth status*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(node --test*)",
      "Bash(node scripts/*)",
      "Bash(node .claude/claudeos/scripts/*)",
      "Bash(bats *)",
      "Bash(shellcheck *)",
      "Bash(jq *)",
      "Bash(python3 scripts/*)",
      "Bash(make *)",
      "Bash(bash bin/release-check.sh*)",
      "Bash(bash bin/github-pr-flow.sh*)",
      "Bash(bash bin/pg-ops.sh health*)",
      "Bash(bash bin/pg-ops.sh status*)",
      "Bash(bash bin/pg-ops.sh verify*)",
      "Bash(bash bin/pg-ops.sh freshness*)",
      "Bash(bash bin/pg-ops.sh migration-risk*)",
      "Bash(bash bin/pg-ops.sh backup*)",
      "Bash(bash libexec/diag-*)",
      "Bash(bash tests/*)",
      "Bash(bash scripts/*)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(printf *)",
      "Bash(which *)",
      "Bash(sed -n *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",
      "Bash(ps *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod +x *)",
      "Bash(tee *)",
      "Bash(rm -f reports/*)",
      "Bash(rm -f logs/*)",
      "Bash(rm -f tmp/*)",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__create_pull_request",
      "mcp__github__create_branch",
      "mcp__github__add_issue_comment",
      "mcp__github__update_pull_request",
      "mcp__github__issue_write",
      "mcp__memory__*",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebSearch"
    ],
    "deny": [
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(eval *)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(xargs *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * +main*)",
      "Bash(git commit * --no-verify*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api -X PUT *)",
      "mcp__github__delete_repository",
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__fork_repository",
      "Bash(crontab *)",
      "Bash(systemctl *)",
      "Bash(claude auto-mode reset*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.json)",
      "Read(~/.env*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.claude/settings.json)",
      "Bash(cat ~/.env*)",
      "Bash(cat .env*)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "main または master ブランチへの直接 git push を実行しない (常に PR 経由でマージする)",
      "main または master ブランチへの force push を実行しない",
      "git commit に --no-verify を付与して pre-commit hook をスキップしない",
      "main ブランチを origin/main に対して git reset --hard で書き換えない",
      "ユーザーの明示的指示なく ~/.claude/CLAUDE.md または .claude/settings.json または .claude/hooks/ を編集しない",
      "CI checks が failing 状態の pull request を merge しない",
      ".claude/ ディレクトリまたは .claude/settings.json を削除しない"
    ]
  }
}
