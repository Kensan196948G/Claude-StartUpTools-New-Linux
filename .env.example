# ClaudeOS v10 — environment example (values are samples only; never commit real secrets)
# Local PostgreSQL is the PostgreSQL source of truth. Connect over the Unix socket on localhost.
# Format: postgresql://<role>:<password>@localhost/<database>?host=/var/run/postgresql
DATABASE_URL=postgresql://claudeos_app:CHANGE_ME@localhost/claudeos?host=/var/run/postgresql
# Test database (isolated; created by `bin/pg-ops.sh init <project>-test`)
TEST_DATABASE_URL=postgresql://claudeos_test_app:CHANGE_ME@localhost/claudeos_test?host=/var/run/postgresql
# Backup root used by bin/pg-ops.sh and the generated systemd units
CCSU_PG_BACKUP_ROOT=/var/backups/claudeos
# Claude Code (subscription auth is preferred; leave empty to use `claude /login`)
ANTHROPIC_API_KEY=
